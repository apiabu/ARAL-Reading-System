<Window x:Class="ARALReadingSystem.Views.TeacherDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAL Ninorte-Samarnon"
        Width="1366"
        Height="768"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8EB">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- COLORS / COMMON STYLES                               -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="NavyBrush"
                         Color="#132A40"/>

        <SolidColorBrush x:Key="BlueBrush"
                         Color="#1596DF"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#6F8193"/>

        <!-- ===================================================== -->
        <!-- SIDEBAR NAV BUTTON                                   -->
        <!-- ===================================================== -->

        <Style x:Key="NavButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="8,2"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#5D7185"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#E8F5FD"/>

                                <Setter Property="Foreground"
                                        Value="#0868A4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ACTIVE NAV -->

        <Style x:Key="ActiveNavButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">

            <Setter Property="Background"
                    Value="#E4F3FC"/>

            <Setter Property="Foreground"
                    Value="#075F98"/>

        </Style>

        <!-- ===================================================== -->
        <!-- ROUNDED BUTTON                                       -->
        <!-- ===================================================== -->

        <Style x:Key="RoundedButtonStyle"
               TargetType="Button">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- CHECK-IN CARD BUTTON                                 -->
        <!-- ===================================================== -->

        <Style x:Key="CheckInCardButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="Transparent">

                            <ContentPresenter/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ========================================================= -->
    <!-- ROOT                                                      -->
    <!-- ========================================================= -->

    <Grid Background="#FFF8EB">

        <Grid.ColumnDefinitions>

            <!-- Screenshot sidebar is about 252 px -->
            <ColumnDefinition x:Name="SidebarColumn" Width="252"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- LEFT SIDEBAR                                         -->
        <!-- ===================================================== -->

        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="White"
                BorderBrush="#E5DED3"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- LOGO                                              -->
                <!-- ================================================= -->

                <Grid Grid.Row="0"
                      Margin="20,0,12,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="14"
                            Background="#1596DF"
                            VerticalAlignment="Center">

                        <TextBlock Text="A"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="ARAL"
                                   Foreground="#142B40"
                                   FontSize="15"
                                   FontWeight="ExtraBold"/>

                        <TextBlock Text="NINORTE-SAMARNON"
                                   Foreground="#91A2B4"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- ================================================= -->
                <!-- NAVIGATION                                        -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="1">

                    <Button Style="{StaticResource ActiveNavButtonStyle}"
                            Click="DashboardButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⌘"
                                       FontSize="19"
                                       Width="31"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Talaan ng Klase"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="PupilsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="♙"
                                       FontSize="19"
                                       Width="31"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Mga Mag-aaral"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="SessionsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▣"
                                       FontSize="18"
                                       Width="31"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Mga Sesyon"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="CheckInsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="☑"
                                       FontSize="18"
                                       Width="31"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Progress Check-in"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- ================================================= -->
                <!-- OFFLINE CARD                                      -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Margin="10,10,10,20"
                        Padding="16,14"
                        CornerRadius="16"
                        Background="#FFF6E7">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⌁"
                                       Foreground="#18A668"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Offline na sistema"
                                       Foreground="#148C58"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock Text="Lahat ng datos at media ay nasa&#10;lokal na kompyuter lamang."
                                   Foreground="#60758A"
                                   FontSize="11"
                                   LineHeight="18"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- MAIN AREA                                            -->
        <!-- ===================================================== -->

        <Grid x:Name="MainArea"
              Grid.Column="1"
              Background="#FFF8EB">

            <Grid.RowDefinitions>
                <RowDefinition Height="95"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

           <!-- ================================================= -->
<!-- SHARED HEADER                                     -->
<!-- ================================================= -->

<Border x:Name="SharedHeader"
        Grid.Row="0"
        Background="#FFF8EB"
        BorderBrush="#E7DFD3"
        BorderThickness="0,0,0,1">

    <Grid Margin="33,0,32,0">

        <Grid.ColumnDefinitions>

            <!-- LEFT: PAGE TITLE -->
            <ColumnDefinition Width="*"/>

            <!-- RIGHT: ACTION + TEACHER + LOGOUT -->
            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- LEFT SIDE                                         -->
        <!-- PAGE TITLE + SUBTITLE                             -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock x:Name="SharedPageTitleText"
                       Text="Maupay, Teacher!"
                       Foreground="#1B3044"
                       FontSize="27"
                       FontWeight="ExtraBold"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="SharedPageSubtitleText"
                       Text="Gapas-gapas Central Elementary School"
                       Foreground="#63778B"
                       FontSize="13"
                       Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- RIGHT SIDE                                        -->
        <!-- + MAGDAGDAG | TEACHER | LOGOUT                   -->
        <!-- ================================================= -->

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <!-- ================================================= -->
            <!-- + MAGDAGDAG                                      -->
            <!-- Visible only when Mga Mag-aaral is open          -->
            <!-- ================================================= -->

            <Button x:Name="SharedAddPupilButton"
                    Width="145"
                    Height="46"
                    Margin="0,0,18,0"
                    Background="#1596DF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="SharedAddPupilButton_Click">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="AddBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="+"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,-1,8,0"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Magdagdag"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="AddBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="AddBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>

            <!-- ================================================= -->
            <!-- VERTICAL DIVIDER                                  -->
            <!-- ================================================= -->

            <Border Width="1"
                    Height="40"
                    Background="#E5DED2"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"/>

            <!-- ================================================= -->
            <!-- TEACHER INFORMATION                               -->
            <!-- ================================================= -->

            <StackPanel Width="176"
                        Margin="0,0,13,0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="TeacherNameText"
                           Text="ARAL Teacher"
                           Foreground="#28394B"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           HorizontalAlignment="Stretch"/>

                <TextBlock Text="ARAL Remedial — Grade 1 &amp; 2"
                           Foreground="#9AABBB"
                           FontSize="11"
                           Margin="0,5,0,0"
                           TextAlignment="Right"
                           HorizontalAlignment="Stretch"/>

            </StackPanel>

            <!-- ================================================= -->
            <!-- LOGOUT BUTTON                                     -->
            <!-- ================================================= -->

            <Button Width="41"
                    Height="41"
                    Background="White"
                    Foreground="#52697C"
                    BorderBrush="#D8DFE5"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="LogoutButton_Click">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="LogoutBorder"
                                Width="41"
                                Height="41"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <TextBlock Text="↪"
                                       Foreground="#52697C"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="LogoutBorder"
                                        Property="Background"
                                        Value="#F5FAFD"/>

                                <Setter TargetName="LogoutBorder"
                                        Property="BorderBrush"
                                        Value="#BFD9E8"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="LogoutBorder"
                                        Property="Background"
                                        Value="#E8F4FA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </StackPanel>

    </Grid>

</Border>

<!-- ================================================= -->
<!-- END SHARED HEADER                                 -->
<!-- ================================================= -->
            <!-- ================================================= -->
            <!-- SCROLLABLE DASHBOARD                              -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="33,32,32,35">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ================================================= -->
                    <!-- UPPER DASHBOARD                                    -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.56*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================================= -->
                        <!-- BLUE AUTO BOOKMARK CARD                            -->
                        <!-- ================================================= -->

                        <Border Grid.Column="0"
                                MinHeight="440"
                                CornerRadius="31"
                                Background="#1D96DE"
                                BorderBrush="#79C5ED"
                                BorderThickness="2">

                            <Grid Margin="32,31,32,31">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="AUTO-BOOKMARK NG KLASE"
                                           Foreground="#DDF4FF"
                                           FontSize="12"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="CurrentSessionTitleText"
                                           Grid.Row="1"
                                           Text="Sesyon 1: Ako Si..."
                                           Foreground="White"
                                           FontSize="42"
                                           FontWeight="ExtraBold"
                                           TextWrapping="Wrap"
                                           LineHeight="47"
                                           Margin="0,13,0,0"/>

                                <TextBlock x:Name="CurrentSessionSubtitleText"
                                           Grid.Row="2"
                                           Text="ARAL Reading Intervention"
                                           Foreground="#EAF8FF"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,13,0,0"/>

                                <!-- hidden compatibility field -->
                                <TextBlock x:Name="CurrentSessionText"
                                           Grid.Row="2"
                                           Visibility="Collapsed"/>

                                <!-- BUTTONS -->

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            Margin="0,30,0,0">

                                    <Button x:Name="ResumeSessionButton"
                                            Width="309"
                                            Height="60"
                                            Background="White"
                                            Foreground="#075B96"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Click="ResumeSessionButton_Click">

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <TextBlock Text="▷"
                                                       FontSize="28"
                                                       FontWeight="Normal"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>

                                            <TextBlock x:Name="ResumeButtonText"
                                                       Text="Ipagpatuloy ang sesyon"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>

                                    <Button Width="203"
                                            Height="56"
                                            Margin="15,2,0,0"
                                            Background="#1D96DE"
                                            Foreground="White"
                                            BorderBrush="#A9DEFA"
                                            BorderThickness="2"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Click="SessionsButton_Click">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Tingnan lahat ng 36"
                                                       FontSize="13"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="›"
                                                       FontSize="22"
                                                       Margin="10,-3,0,0"/>

                                        </StackPanel>

                                    </Button>

                                </StackPanel>

                                <!-- PROGRESS -->

                                <Border Grid.Row="5"
                                        Background="#0878BE"
                                        CornerRadius="23"
                                        Padding="20,20,20,19"
                                        Margin="0,31,0,0">

                                    <StackPanel>

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Natapos na sesyon"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">

                                                <TextBlock x:Name="CompletedSessionText"
                                                           Text="0"
                                                           Foreground="White"
                                                           FontSize="21"
                                                           FontWeight="ExtraBold"/>

                                                <TextBlock Text=" / 36"
                                                           Foreground="#D5EEFC"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Bottom"
                                                           Margin="2,0,0,2"/>

                                            </StackPanel>

                                        </Grid>

                                        <!-- Custom progress background -->

                                        <Grid Height="13"
                                              Margin="0,13,0,0">

                                            <Border CornerRadius="7"
                                                    Background="#075E98"/>

                                            <ProgressBar x:Name="SessionProgressBar"
                                                         Minimum="0"
                                                         Maximum="36"
                                                         Value="0"
                                                         Height="13"
                                                         Background="Transparent"
                                                         Foreground="#FFC94B"
                                                         BorderThickness="0"/>

                                        </Grid>

                                        <TextBlock x:Name="SessionProgressText"
                                                   Text="0 / 36"
                                                   Visibility="Collapsed"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Border>

                        <!-- ================================================= -->
                        <!-- RIGHT SIDE                                         -->
                        <!-- ================================================= -->

                        <Grid Grid.Column="2">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="138"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="218"/>
                            </Grid.RowDefinitions>

                            <!-- TIKTIK CARD -->

                            <Border Grid.Row="0"
                                    Background="White"
                                    BorderBrush="#E1DDD6"
                                    BorderThickness="1"
                                    CornerRadius="31"
                                    Padding="20">

                                <Border.Effect>

                                    <DropShadowEffect Color="#D7CDBE"
                                                      BlurRadius="10"
                                                      ShadowDepth="3"
                                                      Opacity="0.30"/>

                                </Border.Effect>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="98"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="96"
                                            Height="96"
                                            CornerRadius="48"
                                            Background="#FFF5E3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">

                                        <!-- Replace this with your actual Tiktik
                                             mascot Image later if you have PNG -->
                                        <TextBlock Text="🐦"
                                                   FontSize="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- SPEECH BUBBLE -->

                                    <Border Grid.Column="1"
                                            Background="#FFFEFC"
                                            BorderBrush="#E6DED1"
                                            BorderThickness="2"
                                            CornerRadius="22"
                                            Margin="11,9,0,9"
                                            Padding="17,12">

                                        <TextBlock Text="Handa na si Tiktik para sa&#10;klase!"
                                                   Foreground="#172B3F"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>

                                    </Border>

                                </Grid>

                            </Border>

                            <!-- ================================================= -->
                            <!-- COHORT CARD                                        -->
                            <!-- ================================================= -->

                            <Border Grid.Row="2"
                                    Background="White"
                                    BorderBrush="#E1DDD6"
                                    BorderThickness="1"
                                    CornerRadius="31"
                                    Padding="24">

                                <Border.Effect>

                                    <DropShadowEffect Color="#D7CDBE"
                                                      BlurRadius="10"
                                                      ShadowDepth="3"
                                                      Opacity="0.30"/>

                                </Border.Effect>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="ARAL cohort"
                                                   Foreground="#152B3F"
                                                   FontSize="18"
                                                   FontWeight="ExtraBold"/>

                                        <Button Grid.Column="1"
                                                Content="Pamahalaan"
                                                Background="Transparent"
                                                Foreground="#0667AC"
                                                BorderThickness="0"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Click="PupilsButton_Click"/>

                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,18,0,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#FFF6E8"
                                                CornerRadius="22"
                                                Padding="17,14">

                                            <StackPanel>

                                                <TextBlock Text="GRADE 1"
                                                           Foreground="#9DAFC1"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>

                                                <TextBlock x:Name="Grade1CountText"
                                                           Text="0"
                                                           Foreground="#152B3F"
                                                           FontSize="26"
                                                           FontWeight="ExtraBold"
                                                           Margin="0,7,0,0"/>

                                            </StackPanel>

                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#FFF6E8"
                                                CornerRadius="22"
                                                Padding="17,14">

                                            <StackPanel>

                                                <TextBlock Text="GRADE 2"
                                                           Foreground="#9DAFC1"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>

                                                <TextBlock x:Name="Grade2CountText"
                                                           Text="0"
                                                           Foreground="#152B3F"
                                                           FontSize="26"
                                                           FontWeight="ExtraBold"
                                                           Margin="0,7,0,0"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal">

                                        <TextBlock Text="♙"
                                                   Foreground="#91A6B7"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock x:Name="CohortSummaryText"
                                                   Text="0 mag-aaral ang nakatala sa lokal na database."
                                                   Foreground="#697D91"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                    <!-- Kept for compatibility -->
                                    <TextBlock x:Name="PupilCountText"
                                               Visibility="Collapsed"
                                               Text="0"/>

                                    <TextBlock x:Name="AvailableCheckInsText"
                                               Visibility="Collapsed"
                                               Text="0"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

                    <!-- ================================================= -->
                    <!-- CHECK-IN SECTION                                   -->
