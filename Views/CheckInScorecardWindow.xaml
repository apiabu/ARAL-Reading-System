<Page x:Class="ARALReadingSystem.Views.CheckInScorecardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#FFF8EB">

    <Page.Resources>

        <!-- =====================================================
             RESULT CHIP
             ===================================================== -->

        <Style x:Key="ResultChipTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>


        <!-- =====================================================
             BACK BUTTON
             ===================================================== -->

        <Style x:Key="BackButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#607487"/>

            <Setter Property="BorderBrush"
                    Value="#D7DEE3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F5F8FA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             PRINT BUTTON
             ===================================================== -->

        <Style x:Key="PrintButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#607487"/>

            <Setter Property="BorderBrush"
                    Value="#D7DEE3"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F5F8FA"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Page.Resources>


    <!-- =========================================================
         ROOT
         ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="94"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
     SCORECARD HEADER
     ===================================================== -->

<Border Grid.Row="0"
        Background="#FFF8EB"
        BorderBrush="#E4DDD2"
        BorderThickness="0,0,0,1">

    <Grid Margin="32,0,32,0">

        <Grid.ColumnDefinitions>

            <!-- TITLE AREA -->
            <ColumnDefinition Width="*"/>

            <!-- SPACE -->
            <ColumnDefinition Width="24"/>

            <!-- BUTTONS -->
            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>


        <!-- =================================================
             TITLE / SUBTITLE
             ================================================= -->

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">

            <TextBlock x:Name="PageTitleText"
                       Text="Scorecard: Mag-aaral"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#1D3043"/>

            <TextBlock x:Name="PageSubtitleText"
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="#61778A"/>

        </StackPanel>


        <!-- =================================================
             ACTION BUTTONS
             ================================================= -->

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">


            <!-- PRINT -->

            <Button Width="104"
                    Height="44"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrintButtonStyle}"
                    Click="PrintButton_Click">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="▣"
                               Margin="0,0,7,0"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="I-print"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>


            <!-- BACK -->

            <Button Width="112"
                    Height="44"
                    Style="{StaticResource BackButtonStyle}"
                    Click="BackButton_Click">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="←"
                               Margin="0,0,7,0"
                               FontSize="17"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Bumalik"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </StackPanel>

    </Grid>

</Border>

        <!-- =====================================================
             BODY
             ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="32,32,32,40">

                <Border x:Name="PrintableCard"
                        Background="White"
                        BorderBrush="#DED9D0"
                        BorderThickness="1"
                        CornerRadius="28"
                        Padding="24">

                    <StackPanel>


                        <!-- =====================================
                             CHECK-IN TITLE / TOTAL
                             ===================================== -->

                        <Grid Margin="0,0,0,25">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock x:Name="CheckInTitleText"
                                           Text="Check-in #1"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#1D3043"/>

                                <TextBlock x:Name="MilestoneText"
                                           Text="Matapos ang Sesyon 9"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Foreground="#61778A"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <TextBlock x:Name="OverallScoreText"
                                               Text="0"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#0877BE"/>

                                    <TextBlock Text="/ 17 tama"
                                               Margin="4,8,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#91A1AF"/>

                                </StackPanel>

                                <TextBlock x:Name="DurationDateText"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#526A7E"/>

                            </StackPanel>

                        </Grid>


                        <!-- =====================================
                             TWO-COLUMN RESULTS
                             ===================================== -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- =================================
                                 LEFT
                                 ================================= -->

                            <StackPanel Grid.Column="0">


                                <!-- TITIK -->

                                <Grid Margin="0,0,0,11">

                                    <TextBlock Text="Titik"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1D3043"/>

                                    <TextBlock x:Name="TitikScoreText"
                                               Text="0 / 6"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#526A7E"/>

                                </Grid>


                                <WrapPanel x:Name="TitikResultsPanel"
                                           Margin="0,0,0,25"/>


                                <!-- SALITA -->

                                <Grid Margin="0,0,0,11">

                                    <TextBlock Text="Salita"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1D3043"/>

                                    <TextBlock x:Name="SalitaScoreText"
                                               Text="0 / 4"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#526A7E"/>

                                </Grid>


                                <WrapPanel x:Name="SalitaResultsPanel"/>

                            </StackPanel>


                            <!-- =================================
                                 RIGHT
                                 ================================= -->

                            <StackPanel Grid.Column="2">


                                <!-- PANTIG -->

                                <Grid Margin="0,0,0,11">

                                    <TextBlock Text="Pantig"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1D3043"/>

                                    <TextBlock x:Name="PantigScoreText"
                                               Text="0 / 4"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#526A7E"/>

                                </Grid>


                                <WrapPanel x:Name="PantigResultsPanel"
                                           Margin="0,0,0,25"/>


                                <!-- PARIRALA -->

                                <Grid Margin="0,0,0,11">

                                    <TextBlock Text="Parirala"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1D3043"/>

                                    <TextBlock x:Name="PariralaScoreText"
                                               Text="0 / 3"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#526A7E"/>

                                </Grid>


                                <WrapPanel x:Name="PariralaResultsPanel"/>

                            </StackPanel>

                        </Grid>


                        <!-- =====================================
                             TEACHER NOTES
                             ===================================== -->

                        <Border Margin="0,24,0,0"
                                Background="#FFF6E7"
                                CornerRadius="22"
                                Padding="16">

                            <StackPanel>

                                <TextBlock Text="PUNA NG GURO"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#91A1AF"/>

                                <TextBlock x:Name="TeacherNotesText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#1D3043"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>