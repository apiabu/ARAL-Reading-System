<Window x:Class="ARALReadingSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ninorte-Samarnon Reading Intervention"
        Width="1366"
        Height="768"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7E9">

    <Window.Resources>

        <!-- LOGIN BUTTON -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="60"/>

            <Setter Property="Background"
                    Value="#1594DF"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.75"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- LEFT LOGIN PANEL                                       -->
        <!-- ====================================================== -->

        <Grid Grid.Column="0"
              Background="#FFF7E9">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="84,22,84,30">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BRAND -->

                    <StackPanel Orientation="Horizontal">

                        <Border Width="48"
                                Height="48"
                                CornerRadius="15"
                                Background="#1594DF">

                            <TextBlock Text="A"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel
                            Margin="12,4,0,0">

                            <TextBlock
                                Text="Ninorte-Samarnon Reading Intervention"
                                Foreground="#102C45"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="COMPUTER-AIDED INSTRUCTION SYSTEM"
                                Foreground="#8DA3BD"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- LOGIN FORM -->

                    <StackPanel Grid.Row="1"
                                Margin="0,42,0,0">

                        <!-- WELCOME -->

                        <TextBlock
                            Text="Maupay nga pag-abot,"
                            Foreground="#102C45"
                            FontSize="32"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="Titser!"
                            Foreground="#102C45"
                            FontSize="32"
                            FontWeight="Bold"
                            Margin="0,-3,0,0"/>

                        <TextBlock
                            Text="An sistemang ito ay para lamang sa guro. Ipasok ang inyong kredensyal upang buksan ang 36 na sesyon at ang talaan ng klase."
                            Foreground="#61768E"
                            FontSize="15"
                            LineHeight="24"
                            TextWrapping="Wrap"
                            Margin="0,13,0,30"/>

                        <!-- USERNAME -->

                        <TextBlock
                            Text="USERNAME"
                            Foreground="#8FA4BF"
                            FontSize="12"
                            FontWeight="Bold"
                            Margin="0,0,0,7"/>

                        <Border
                            Height="56"
                            Background="White"
                            BorderBrush="#D8D8D5"
                            BorderThickness="2"
                            CornerRadius="15">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Simple user symbol -->
                                <TextBlock
                                    Text="♙"
                                    FontSize="20"
                                    Foreground="#91A8BD"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Border
                                    Grid.Column="1"
                                    Background="#EAF2FF"
                                    CornerRadius="0,13,13,0">

                                    <TextBox
                                        x:Name="UsernameTextBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Padding="0"
                                        Margin="0,0,14,0"
                                        VerticalContentAlignment="Center"
                                        Foreground="#101820"/>

                                </Border>

                            </Grid>

                        </Border>

                        <!-- PASSWORD -->

                        <TextBlock
                            Text="PASSWORD"
                            Foreground="#8FA4BF"
                            FontSize="12"
                            FontWeight="Bold"
                            Margin="0,16,0,7"/>

                        <Border
                            Height="56"
                            Background="White"
                            BorderBrush="#D8D8D5"
                            BorderThickness="2"
                            CornerRadius="15">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="▣"
                                    FontSize="18"
                                    Foreground="#91A8BD"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <Border
                                    Grid.Column="1"
                                    Background="#EAF2FF"
                                    CornerRadius="0,13,13,0">

                                    <PasswordBox
                                        x:Name="PasswordBox"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="16"
                                        Padding="0"
                                        Margin="0,0,14,0"
                                        VerticalContentAlignment="Center"
                                        Foreground="#101820"/>

                                </Border>

                            </Grid>

                        </Border>

                        <!-- ERROR -->

                        <TextBlock
                            x:Name="ErrorText"
                            Visibility="Collapsed"
                            Foreground="#C43D3D"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Margin="4,10,0,0"/>

                        <!-- LOGIN -->

                        <Button
                            x:Name="LoginButton"
                            Content="Mag-login"
                            Style="{StaticResource PrimaryButton}"
                            Click="LoginButton_Click"
                            Margin="0,16,0,0"/>

                        <!-- OFFLINE NOTICE -->

                        <Border
                            Background="White"
                            CornerRadius="15"
                            Padding="16,12"
                            Margin="0,22,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="⌁"
                                    Foreground="#159E69"
                                    FontSize="20"
                                    VerticalAlignment="Top"/>

                                <StackPanel Grid.Column="1">

                                    <TextBlock
                                        Text="Walang koneksyon sa internet ang kailangan. Kredensyal para sa demo:"
                                        Foreground="#687E95"
                                        FontSize="11"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Text="teacher / Teacher123!"
                                        Foreground="#102C45"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Margin="0,4,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Grid>

        <!-- ====================================================== -->
        <!-- RIGHT PRESENTATION PANEL                               -->
        <!-- ====================================================== -->

        <Grid Grid.Column="1"
              Background="#D4ECFB">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ILLUSTRATION AREA -->

            <Border
                Width="512"
                Height="384"
                CornerRadius="30"
                Background="#FFF7E9"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,25,0,0">

                <Grid>

                    <!--
                    When login-classroom.png is added:

                    <Image Source="/Assets/Images/login-classroom.png"
                           Stretch="UniformToFill"/>

                    -->

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="ARAL"
                            Foreground="#1594DF"
                            FontWeight="Bold"
                            FontSize="48"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Classroom Illustration"
                            Foreground="#8DA3BD"
                            FontSize="16"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- BOTTOM MESSAGE -->

            <TextBlock
                Grid.Row="1"
                Text="36 na sesyon ng Marungko, may 2D animasyon&#10;at katutubong Ninorte-Samarnon na voiceover."
                Foreground="#075D9F"
                FontSize="21"
                FontWeight="Bold"
                TextAlignment="Center"
                LineHeight="34"
                Margin="40,20,40,38"/>

        </Grid>

    </Grid>

</Window>