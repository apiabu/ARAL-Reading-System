<Window x:Class="ARALReadingSystem.Views.AddPupilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magdagdag ng Mag-aaral"
        Width="620"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF8EC">

    <Window.Resources>

        <Style x:Key="ChoiceButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="46"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
            <Setter Property="Padding"
                    Value="18,8"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Foreground"
                    Value="#52687B"/>
            <Setter Property="BorderBrush"
                    Value="#E3D8C8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Padding"
                    Value="12,8"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#E3D8C8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#34495E"/>
            <Setter Property="Margin"
                    Value="0,0,0,7"/>
        </Style>

    </Window.Resources>


    <Grid>
        <Border Margin="28"
                Padding="30"
                Background="White"
                CornerRadius="18"
                BorderBrush="#E9DDCC"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ========================================= -->
                    <!-- HEADER -->
                    <!-- ========================================= -->

                    <TextBlock x:Name="HeaderText"
                               Text="Magdagdag ng Mag-aaral"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#263E50"/>

                    <TextBlock x:Name="SubtitleText"
                               Text="Ilagay ang impormasyon ng mag-aaral."
                               Margin="0,7,0,26"
                               FontSize="14"
                               Foreground="#718096"/>


                    <!-- ========================================= -->
                    <!-- FIRST NAME -->
                    <!-- ========================================= -->

                    <TextBlock Text="Pangalan"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="FirstNameTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,18"/>


                    <!-- ========================================= -->
                    <!-- LAST NAME -->
                    <!-- ========================================= -->

                    <TextBlock Text="Apelyido"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox x:Name="LastNameTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,18"/>


                    <!-- ========================================= -->
                    <!-- GRADE LEVEL -->
                    <!-- ========================================= -->

                    <TextBlock x:Name="GradeLevelLabel"
                               Text="Grade Level"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <Grid x:Name="GradeLevelOptions"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="Grade1Button"
                                Grid.Column="0"
                                Content="Grade 1"
                                Style="{StaticResource ChoiceButtonStyle}"
                                Click="Grade1Button_Click"/>

                        <Button x:Name="Grade2Button"
                                Grid.Column="1"
                                Content="Grade 2"
                                Margin="10,0,0,0"
                                Style="{StaticResource ChoiceButtonStyle}"
                                Click="Grade2Button_Click"/>
                    </Grid>


                    <!-- ========================================= -->
                    <!-- GENDER -->
                    <!-- ========================================= -->

                    <TextBlock x:Name="GenderLabel"
                               Text="Kasarian"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <Grid x:Name="GenderOptions"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MaleButton"
                                Grid.Column="0"
                                Content="Lalaki"
                                Style="{StaticResource ChoiceButtonStyle}"
                                Click="MaleButton_Click"/>

                        <Button x:Name="FemaleButton"
                                Grid.Column="1"
                                Content="Babae"
                                Margin="10,0,0,0"
                                Style="{StaticResource ChoiceButtonStyle}"
                                Click="FemaleButton_Click"/>
                    </Grid>


                    <!-- ========================================= -->
                    <!-- BIRTHDATE -->
                    <!-- ========================================= -->

                    <TextBlock x:Name="BirthdateLabel"
                               Text="Petsa ng Kapanganakan"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <DatePicker x:Name="BirthdatePicker"
                                Height="44"
                                FontSize="15"
                                SelectedDateFormat="Long"
                                Margin="0,0,0,22"/>


                    <!-- ========================================= -->
                    <!-- ERROR -->
                    <!-- ========================================= -->

                    <Border Background="#FFF1F1"
                            BorderBrush="#F2CACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,18">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ErrorText,
                                                                  Path=Visibility}"
                                                 Value="Visible">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock x:Name="ErrorText"
                                   Visibility="Collapsed"
                                   Foreground="#B42318"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>


                    <!-- ========================================= -->
                    <!-- BUTTONS -->
                    <!-- ========================================= -->

                    <Grid Margin="0,4,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Kanselahin"
                                Height="48"
                                Margin="0,0,8,0"
                                Background="White"
                                Foreground="#52687B"
                                BorderBrush="#D9DDE2"
                                BorderThickness="1"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="CancelButton_Click"/>

                        <Button x:Name="SaveButton"
                                Grid.Column="1"
                                Content="I-save"
                                Height="48"
                                Margin="8,0,0,0"
                                Background="#1594DF"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="SaveButton_Click"/>

                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>