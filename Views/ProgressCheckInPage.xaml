<Page x:Class="ARALReadingSystem.Views.ProgressCheckInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Progress Check-in"
      Background="#FFF8EB">

    <Page.Resources>

        <!-- ===================================================== -->
        <!-- CHECK-IN SELECTOR                                    -->
        <!-- ===================================================== -->

        <Style x:Key="CheckInSelectorStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#DCE6ED"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="OuterBorder"
                                        Property="Background"
                                        Value="#F7FBFF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.68"/>

                                <Setter Property="Cursor"
                                        Value="Arrow"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- PRIMARY ACTION BUTTON                                -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="#0877BE"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0667A6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- ===================================================== -->
        <!-- SECONDARY ACTION BUTTON                              -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#243B4A"/>

            <Setter Property="BorderBrush"
                    Value="#CBD8E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F6FAFC"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                                <Setter Property="Cursor"
                                        Value="Arrow"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Page.Resources>

    <!-- ========================================================= -->
    <!-- CONTENT ONLY                                             -->
    <!-- TeacherDashboard owns sidebar + shared header             -->
    <!-- ========================================================= -->

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="32,26,32,36">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- CHECK-IN SELECTORS                                -->
                <!-- ================================================= -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CHECK-IN #1 -->

                    <Button x:Name="CheckIn1Button"
                            Grid.Column="0"
                            Height="94"
                            Tag="1"
                            Style="{StaticResource CheckInSelectorStyle}"
                            Click="CheckInSelector_Click">

                        <Grid Margin="17,13">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckIn1IconBorder"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#E9F8F0"
                                    CornerRadius="18">

                                <TextBlock x:Name="CheckIn1Icon"
                                           Text="✓"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1EAD6F"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Check-in #1"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D"/>

                                <TextBlock Text="Matapos ang Sesyon 9"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="#718594"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                    <!-- CHECK-IN #2 -->

                    <Button x:Name="CheckIn2Button"
                            Grid.Column="2"
                            Height="94"
                            Tag="2"
                            Style="{StaticResource CheckInSelectorStyle}"
                            Click="CheckInSelector_Click">

                        <Grid Margin="17,13">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckIn2IconBorder"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#F1F4F6"
                                    CornerRadius="18">

                                <TextBlock x:Name="CheckIn2Icon"
                                           Text="🔒"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="#7E909D"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Check-in #2"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D"/>

                                <TextBlock Text="Matapos ang Sesyon 18"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="#718594"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                    <!-- CHECK-IN #3 -->

                    <Button x:Name="CheckIn3Button"
                            Grid.Column="4"
                            Height="94"
                            Tag="3"
                            Style="{StaticResource CheckInSelectorStyle}"
                            Click="CheckInSelector_Click">

                        <Grid Margin="17,13">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckIn3IconBorder"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#F1F4F6"
                                    CornerRadius="18">

                                <TextBlock x:Name="CheckIn3Icon"
                                           Text="🔒"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="#7E909D"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Check-in #3"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D"/>

                                <TextBlock Text="Matapos ang Sesyon 27"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="#718594"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                    <!-- CHECK-IN #4 -->

                    <Button x:Name="CheckIn4Button"
                            Grid.Column="6"
                            Height="94"
                            Tag="4"
                            Style="{StaticResource CheckInSelectorStyle}"
                            Click="CheckInSelector_Click">

                        <Grid Margin="17,13">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckIn4IconBorder"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#F1F4F6"
                                    CornerRadius="18">

                                <TextBlock x:Name="CheckIn4Icon"
                                           Text="🔒"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="#7E909D"/>

                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Check-in #4"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#17324D"/>

                                <TextBlock Text="Matapos ang Sesyon 36"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="#718594"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                </Grid>

                <!-- ================================================= -->
                <!-- CATEGORY SUMMARY                                  -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#E2E8EC"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="20,18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="TITIK"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#647A89"/>

                            <TextBlock Text="6 aytem"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="1"
                                Background="#E6EBEF"/>

                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="PANTIG"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#647A89"/>

                            <TextBlock Text="4 aytem"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D"/>

                        </StackPanel>

                        <Border Grid.Column="3"
                                Width="1"
                                Background="#E6EBEF"/>

                        <StackPanel Grid.Column="4"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="SALITA"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#647A89"/>

                            <TextBlock Text="4 aytem"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D"/>

                        </StackPanel>

                        <Border Grid.Column="5"
                                Width="1"
                                Background="#E6EBEF"/>

                        <StackPanel Grid.Column="6"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="PARIRALA"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#647A89"/>

                            <TextBlock Text="3 aytem"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ================================================= -->
                <!-- CURRENT CHECK-IN                                  -->
                <!-- ================================================= -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock x:Name="SelectedCheckInTitleText"
                                   Text="Check-in #1"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#17324D"/>

                        <TextBlock x:Name="SelectedCheckInSubtitleText"
                                   Text="Mga mag-aaral na nakatapos na ng Sesyon 9."
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="#718594"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="#E9F3FA"
                            CornerRadius="12"
                            Padding="11,5">

                        <TextBlock x:Name="PupilSummaryText"
                                   Text="0 mag-aaral"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0877BE"/>

                    </Border>

                </Grid>

                <!-- ================================================= -->
                <!-- CARDS / EMPTY STATE                               -->
                <!-- ================================================= -->

                <Grid Grid.Row="6">

                    <!-- EMPTY STATE -->

                    <Border x:Name="EmptyStateBorder"
                            Visibility="Collapsed"
                            MinHeight="220"
                            Background="White"
                            BorderBrush="#E1E8ED"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="30">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Border Width="52"
                                    Height="52"
                                    Background="#EEF6FB"
                                    CornerRadius="26">

                                <TextBlock Text="✓"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#0877BE"/>

                            </Border>

                            <TextBlock x:Name="EmptyStateTitleText"
                                       Text="Walang mag-aaral"
                                       Margin="0,15,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#17324D"/>

                            <TextBlock x:Name="EmptyStateMessageText"
                                       Text="Wala pang mag-aaral na maaaring mag-check-in."
                                       Margin="0,7,0,0"
                                       MaxWidth="500"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#718594"/>

                        </StackPanel>

                    </Border>

                    <!-- PUPIL CARDS -->

                    <ItemsControl x:Name="PupilCardsControl">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <UniformGrid Columns="3"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Margin="0,0,14,14"
                                        MinHeight="225"
                                        Background="White"
                                        BorderBrush="#DFE7EC"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="20">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- NAME AND STATUS -->

                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding FullName}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#17324D"/>

                                            <Border Grid.Column="1"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="11"
                                                    Padding="10,4">

                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding StatusForeground}"/>

                                            </Border>

                                        </Grid>

                                        <!-- GRADE -->

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding GradeLevel}"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="#718594"/>

                                        <!-- SCORE -->

                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding ScoreText}"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   Foreground="#17324D"/>

                                        <!-- DETAIL -->

                                        <TextBlock Grid.Row="4"
                                                   Text="{Binding DetailText}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="#718594"/>

                                        <!-- ACTION BUTTONS -->

                                        <Grid Grid.Row="6"
                                              Margin="0,18,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Style="{StaticResource PrimaryActionButton}"
                                                    Tag="{Binding}"
                                                    Click="RecordScoreButton_Click">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Text="✎"
                                                               Margin="0,0,7,0"
                                                               FontSize="15"/>

                                                    <TextBlock Text="{Binding ActionText}"/>

                                                </StackPanel>

                                            </Button>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryActionButton}"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding HasResult}"
                                                    Click="ScorecardButton_Click">

                                                <TextBlock Text="Scorecard"/>

                                            </Button>

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</Page>