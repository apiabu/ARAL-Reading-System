<Window x:Class="ARALReadingSystem.Views.CheckInPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#565A5E">

    <Window.Resources>

        <Style x:Key="SettingComboStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="PrintButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="94"/>
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Background"
                    Value="#A9C7F7"/>
            <Setter Property="Foreground"
                    Value="#173B68"/>
            <Setter Property="BorderBrush"
                    Value="#8CAFE8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="CancelButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="94"/>
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#E4E8EC"/>
            <Setter Property="BorderBrush"
                    Value="#7C838A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>


        <!-- =====================================================
             LEFT - A4 PREVIEW
             ===================================================== -->

        <Grid Grid.Column="0"
              Background="#5B5F63">

            <ScrollViewer x:Name="PreviewScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="30">

                <StackPanel HorizontalAlignment="Center">

                    <Border Background="White"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            Padding="0"
                            Margin="0,0,0,30">

                        <!--
                            A4 ratio.
                            This is a scaled screen preview.
                        -->
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="DownOnly">

                            <Border Width="794"
                                    Height="1123"
                                    Background="White">

                                <Grid Margin="42,24,42,26">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <!-- TOP META -->

                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,15">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="PreviewDateText"
                                                   Grid.Column="0"
                                                   FontSize="8"
                                                   Foreground="#334455"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Internal Preview"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334455"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="ARAL Reading System"
                                                   FontSize="8"
                                                   Foreground="#7A8791"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>


                                    <!-- PUPIL / TEACHER HEADER -->

                                    <Grid Grid.Row="1"
                                          Margin="20,0,20,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="230"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Grid.Column="0">

                                            <TextBlock x:Name="PupilNameText"
                                                       Text="Scorecard: Mag-aaral"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#1D3043"/>

                                            <TextBlock x:Name="PupilInfoText"
                                                       Margin="0,5,0,0"
                                                       FontSize="9.5"
                                                       Foreground="#61778A"/>

                                        </StackPanel>


                                        <Border Grid.Column="1"
                                                Width="1"
                                                Background="#E5DED4"
                                                HorizontalAlignment="Center"/>


                                        <Grid Grid.Column="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">

                                                <TextBlock x:Name="TeacherNameText"
                                                           Text="ARAL Teacher"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D3043"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock x:Name="TeacherRoleText"
                                                           Text="ARAL Remedial — Grade 1 &amp; 2"
                                                           Margin="0,3,0,0"
                                                           FontSize="8.5"
                                                           Foreground="#8797A6"
                                                           HorizontalAlignment="Right"/>

                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="10,0,0,0"
                                                    CornerRadius="8"
                                                    BorderBrush="#D9E0E6"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="↪"
                                                           FontSize="15"
                                                           Foreground="#6B8296"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Border>

                                        </Grid>

                                    </Grid>


                                    <!-- NAVIGATION -->

                                    <StackPanel Grid.Row="2">

                                        <WrapPanel Margin="20,0,20,12">

                                            <Border Padding="10,5"
                                                    Margin="0,0,7,0"
                                                    CornerRadius="12"
                                                    BorderBrush="#D6DDE3"
                                                    BorderThickness="1">
                                                <TextBlock Text="▦  Talaan ng Klase"
                                                           FontSize="8.5"
                                                           Foreground="#31475A"/>
                                            </Border>

                                            <Border Padding="10,5"
                                                    Margin="0,0,7,0"
                                                    CornerRadius="12"
                                                    BorderBrush="#D6DDE3"
                                                    BorderThickness="1">
                                                <TextBlock Text="♙  Mga Mag-aaral"
                                                           FontSize="8.5"
                                                           Foreground="#31475A"/>
                                            </Border>

                                            <Border Padding="10,5"
                                                    Margin="0,0,7,0"
                                                    CornerRadius="12"
                                                    BorderBrush="#D6DDE3"
                                                    BorderThickness="1">
                                                <TextBlock Text="▣  Mga Sesyon"
                                                           FontSize="8.5"
                                                           Foreground="#31475A"/>
                                            </Border>

                                            <Border Padding="10,5"
                                                    CornerRadius="12"
                                                    BorderBrush="#D6DDE3"
                                                    BorderThickness="1">
                                                <TextBlock Text="▣  Progress Check-in"
                                                           FontSize="8.5"
                                                           Foreground="#31475A"/>
                                            </Border>

                                        </WrapPanel>

                                        <Border Height="1"
                                                Background="#E7DFD5"
                                                Margin="0,0,0,20"/>

                                    </StackPanel>


                                    <!-- REPORT -->

                                    <StackPanel x:Name="ReportPanel"
                                                Grid.Row="3"
                                                Margin="20,0,20,0"/>


                                    <!-- FOOTER -->

                                    <Grid Grid.Row="4"
                                          Margin="0,15,0,0">

                                        <TextBlock x:Name="FooterText"
                                                   Text="Ninorte-Samarnon Reading Intervention"
                                                   FontSize="7"
                                                   Foreground="#6C7882"
                                                   HorizontalAlignment="Left"/>

                                        <TextBlock x:Name="PageNumberText"
                                                   Text="1/1"
                                                   FontSize="7"
                                                   Foreground="#344655"
                                                   HorizontalAlignment="Right"/>

                                    </Grid>

                                </Grid>

                            </Border>

                        </Viewbox>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>


        <!-- =====================================================
             RIGHT - PRINT SETTINGS
             ===================================================== -->

        <Border Grid.Column="1"
                Background="#292B2E">

            <Grid Margin="32,28,32,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- TITLE -->

                <Grid Grid.Row="0">

                    <TextBlock Text="Print"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock x:Name="SheetCountText"
                               Text="1 sheet of paper"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>

                </Grid>


                <!-- DESTINATION -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Destination"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="DestinationComboBox"
                              Grid.Column="1"
                              Style="{StaticResource SettingComboStyle}"
                              SelectedIndex="0">

                        <ComboBoxItem Content="System printer..."/>

                    </ComboBox>

                </Grid>


                <!-- PAGES -->

                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Pages"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="PagesComboBox"
                              Grid.Column="1"
                              Style="{StaticResource SettingComboStyle}"
                              SelectedIndex="0">

                        <ComboBoxItem Content="All"/>

                    </ComboBox>

                </Grid>


                <!-- LAYOUT -->

                <Grid Grid.Row="6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Layout"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="LayoutComboBox"
                              Grid.Column="1"
                              Style="{StaticResource SettingComboStyle}"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Portrait"/>

                    </ComboBox>

                </Grid>


                <!-- COLOR -->

                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Color"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="ColorComboBox"
                              Grid.Column="1"
                              Style="{StaticResource SettingComboStyle}"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Color"/>

                    </ComboBox>

                </Grid>


                <!-- MORE SETTINGS -->

                <Border Grid.Row="10"
                        BorderBrush="#3D4044"
                        BorderThickness="0,1,0,1"
                        Padding="0,16">

                    <Grid>

                        <TextBlock Text="More settings"
                                   FontSize="13"
                                   Foreground="White"/>

                        <TextBlock Text="⌄"
                                   FontSize="16"
                                   Foreground="#AAB0B6"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                </Border>


                <!-- ACTIONS -->

                <StackPanel Grid.Row="12"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Print"
                            Style="{StaticResource PrintButtonStyle}"
                            Margin="0,0,12,0"
                            Click="PrintButton_Click"/>

                    <Button Content="Cancel"
                            Style="{StaticResource CancelButtonStyle}"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>