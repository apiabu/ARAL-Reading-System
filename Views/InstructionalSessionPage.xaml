                                HorizontalAlignment="Center">


                        <Border Background="#DFF5E7"
                                CornerRadius="20"
                                Padding="18,8"
                                HorizontalAlignment="Center">

                            <TextBlock Text="Pagtapos"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#168552"/>

                        </Border>


                        <TextBlock x:Name="ReviewTitleText"
                                   Text="Maupay!"
                                   Margin="0,16,0,0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#183149"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>


