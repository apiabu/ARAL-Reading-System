                                               FontWeight="Bold"
                                               Foreground="#D94B45"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="KALIWA"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#D94B45"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="3 bagay"
                                               Margin="0,5,0,0"
                                               Foreground="#60798E"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <!-- TABLE -->

                                <Grid Grid.Column="1"
                                      VerticalAlignment="Center">

                                    <StackPanel>

                                        <TextBlock Text="🍽"
                                                   FontSize="85"
                                                   HorizontalAlignment="Center"/>

                                        <Border Background="#FFF4DB"
                                                CornerRadius="12"
                                                Padding="12,7">

                                            <TextBlock Text="Kainan"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#755C29"
                                                       HorizontalAlignment="Center"/>

                                        </Border>

                                    </StackPanel>

                                </Grid>


                                <!-- RIGHT -->

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="→"
                                               FontSize="42"
                                               FontWeight="Bold"
                                               Foreground="#1594DF"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="KANAN"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1594DF"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="3 bagay"
                                               Margin="0,5,0,0"
                                               Foreground="#60798E"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <Border Margin="0,18,0,0"
                                Background="#EAF6FD"
                                CornerRadius="14"
                                Padding="18">

                            <TextBlock x:Name="HomePromptText"
                                       FontSize="14"
                                       Foreground="#27536F"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>


            <!-- =================================================
                 REVIEW / FINISH
                 ================================================= -->

            <Grid x:Name="ReviewPanel"
                  Visibility="Collapsed">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

