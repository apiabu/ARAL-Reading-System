                                           TextWrapping="Wrap"/>


                                <TextBlock x:Name="ReviewInterestLabelText"
                                           Text="Buruhaton"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#8393A0"/>

                                <TextBlock x:Name="ReviewInterestText"
