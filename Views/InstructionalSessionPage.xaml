                                        Background="#FAFAF8"
                                        BorderBrush="#E5E0D7"
                                        BorderThickness="1"
                                        CornerRadius="14">

                                    <InkCanvas x:Name="ReviewDrawingCanvas"
                                               Background="Transparent"
                                               IsHitTestVisible="False"
                                               EditingMode="None"/>

                                </Border>


