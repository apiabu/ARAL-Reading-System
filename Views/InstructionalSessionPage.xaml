                    Margin="24,12"
                    Padding="20,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#EAF6FD"
                    BorderBrush="#B8DFF3"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">

                <TextBlock x:Name="ActivityFeedbackText"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#0879BC"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

            </Border>

        </Grid>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#ECE8E0"
                BorderThickness="0,1,0,0">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <Button x:Name="PreviousStepButton"
                        Grid.Column="0"
                        Content="←  Bumalik"
