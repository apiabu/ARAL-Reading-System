                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#A0ABB4"/>


                <Button x:Name="NextStepButton"
                        Grid.Column="2"
                        Content="Susunod  →"
                        MinWidth="135"
                        Height="46"
                        VerticalAlignment="Center"
